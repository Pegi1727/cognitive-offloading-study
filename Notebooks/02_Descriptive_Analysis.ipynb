   "source": [
    "# Descriptive Statistics\n",
    "Calculating means and SDs by Group."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d9d6a750",
   "metadata": {},
   "outputs": [],
   "source": [
    "library(dplyr)\n",
    "d <- read.csv('screening_data.csv')\n",
    "stats <- d %>% group_by(Group_Note) %>% summarise(mean_total = mean(Total), sd = sd(Total))\n",
    "print(stats)"
   ]
  }
 ],
